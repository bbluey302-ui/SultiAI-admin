{
  "name": "sultiai-server",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:ts": "tsx src/index.ts",
    "build": "tsc",
    "models": "tsx scripts/setup-models.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:setup-supabase": "node scripts/setup-supabase.js",
    "db:seed-learning": "tsx src/scripts/seed-learning-content.ts",
    "db:test-supabase": "node scripts/test-supabase-connection.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:dsp": "tsx src/__tests__/dsp/verify-dsp.ts",
    "test:routes": "tsx src/__tests__/dsp/verify-routes.ts",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@sentry/nextjs": "^10.73.0",
    "@sentry/node": "^10.73.0",
    "@supabase/server": "^1.9.2",
    "@supabase/supabase-js": "^2.118.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "form-data": "^4.0.6",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.2",
    "msedge-tts": "^2.1.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "uuid": "^14.0.3",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.11",
    "jest": "^29.7.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
