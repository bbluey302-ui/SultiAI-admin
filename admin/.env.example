# Copy to .env.local and fill in from your Supabase project settings.
# Project Settings → API exposes the URL, the publishable key and the secret key.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle.
# SUPABASE_SECRET_KEY is server-only and must never be prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Optional: only needed if the console is hosted separately from its API.
# NEXT_PUBLIC_ADMIN_API_URL=https://admin.example.com
